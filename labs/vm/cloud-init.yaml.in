#cloud-config
# Generated by python3 -m engine.vm_labs export. Only launch in a new disposable VM.
hostname: @@HOSTNAME@@
manage_etc_hosts: true
package_update: true
package_upgrade: false
packages:
@@PACKAGES@@
write_files:
@@WRITE_FILES@@
runcmd:
  - [systemctl, disable, --now, nginx.service, dnsmasq.service]
  - [install, -d, -m, '0700', /var/lib/linuxdojo-vm-lab/state]
  - [chown, root:root, /usr/local/lib/linuxdojo-vm-lab, /usr/local/lib/linuxdojo-vm-lab/modules]
  - [chmod, '0755', /usr/local/lib/linuxdojo-vm-lab, /usr/local/lib/linuxdojo-vm-lab/modules]
final_message: 'LinuxDOJO disposable VM provisioning finished; review cloud-init status before labs.'
