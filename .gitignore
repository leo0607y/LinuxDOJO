# Default deny: only reviewed project files are eligible for publication.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.*
!/start.sh
!/install-start.sh
!/start.bat
!/.gitattributes
!/engine/
!/curriculum/
!/tests/
!/bin/

/engine/*
!/engine/*.py
!/engine/*.bash
/curriculum/*
!/curriculum/*.py
!/curriculum/festival/
/curriculum/festival/*
!/curriculum/festival/*.py
/tests/*
!/tests/*.py
/bin/*
!/bin/mock/
!/bin/sim/
/bin/mock/*
!/bin/mock/docker
!/bin/mock/docker-compose
/bin/sim/*
!/bin/sim/adduser
!/bin/sim/crontab
!/bin/sim/getent
!/bin/sim/gpasswd
!/bin/sim/groupadd
!/bin/sim/groupdel
!/bin/sim/groups
!/bin/sim/id
!/bin/sim/journalctl
!/bin/sim/passwd
!/bin/sim/sudo
!/bin/sim/systemctl
!/bin/sim/useradd
!/bin/sim/userdel
!/bin/sim/usermod

# Never publish runtime state, environment snapshots, credentials or caches.
workspace/
.lq_state/
sysroot/
save_data.json
save_data.tmp
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.venv/
venv/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*
secrets*
.aws/
.ssh/
.codex/
.agents/
*.log
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# plugin commands and expert units
!/engine/commands/
/engine/commands/*
!/engine/commands/*.py
!/curriculum/units/
/curriculum/units/*
!/curriculum/units/*.py

# handoff docs and audit tools
!/docs/
/docs/*
!/docs/*.md
!/docs/vm_verification/
/docs/vm_verification/*
!/docs/vm_verification/*.md
!/tools/
/tools/*
!/tools/*.py
!/tools/vmtest/
/tools/vmtest/*
!/tools/vmtest/*.py
!/tools/vmtest/scenarios/
/tools/vmtest/scenarios/*
!/tools/vmtest/scenarios/*.sh

# Disposable-VM course sources are teaching material, not generated VM images.
!/labs/
/labs/*
!/labs/vm/
/labs/vm/*
!/labs/vm/*.md
!/labs/vm/cloud-init.yaml.in
!/labs/vm/guest/
/labs/vm/guest/*
!/labs/vm/guest/dojo-vm-lab
!/labs/vm/guest/modules/
/labs/vm/guest/modules/*
!/labs/vm/guest/modules/*.sh

# Next.js static site (web/danganlog): sources only; generated assets and dependencies are ignored.
!/web/
/web/*
!/web/danganlog/
/web/danganlog/*
!/web/danganlog/README.md
!/web/danganlog/package.json
!/web/danganlog/package-lock.json
!/web/danganlog/next.config.mjs
!/web/danganlog/.node-version
!/web/danganlog/.env.deploy.example
!/web/danganlog/app/
!/web/danganlog/components/
!/web/danganlog/lib/
!/web/danganlog/scripts/
!/web/danganlog/tests/
!/web/danganlog/public/
/web/danganlog/public/*
!/web/danganlog/public/worker.js
!/web/danganlog/public/_headers
!/web/danganlog/public/fonts/
/web/danganlog/public/fonts/*
!/web/danganlog/public/fonts/*.woff2
!/web/danganlog/public/fonts/*.ttf
!/web/danganlog/public/fonts/UFL-*.txt
node_modules/
.next/
out/

# Deploy secrets and tool state (kept after allowlist so they always win).
.env.deploy
.dev.vars
.wrangler/
wrangler.toml.local
*.token
.npmrc
.netrc
.git-credentials
.config/
.cloudflared/
cert.pem
