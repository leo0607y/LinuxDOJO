# Default deny: only reviewed project files are eligible for publication.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.*
!/start.sh
!/install-start.sh
!/start.bat
!/.gitattributes
!/engine/
!/curriculum/
!/tests/
!/bin/

/engine/*
!/engine/*.py
!/engine/*.bash
/curriculum/*
!/curriculum/*.py
!/curriculum/festival/
/curriculum/festival/*
!/curriculum/festival/*.py
/tests/*
!/tests/*.py
/bin/*
!/bin/mock/
!/bin/sim/
/bin/mock/*
!/bin/mock/docker
!/bin/mock/docker-compose
/bin/sim/*
!/bin/sim/adduser
!/bin/sim/crontab
!/bin/sim/getent
!/bin/sim/gpasswd
!/bin/sim/groupadd
!/bin/sim/groupdel
!/bin/sim/groups
!/bin/sim/id
!/bin/sim/journalctl
!/bin/sim/passwd
!/bin/sim/sudo
!/bin/sim/systemctl
!/bin/sim/useradd
!/bin/sim/userdel
!/bin/sim/usermod

# Never publish runtime state, environment snapshots, credentials or caches.
workspace/
.lq_state/
sysroot/
save_data.json
save_data.tmp
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.venv/
venv/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*
secrets*
.aws/
.ssh/
.codex/
.agents/
*.log
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# plugin commands and expert units
!/engine/commands/
/engine/commands/*
!/engine/commands/*.py
!/curriculum/units/
/curriculum/units/*
!/curriculum/units/*.py

# handoff docs and audit tools
!/docs/
/docs/*
!/docs/*.md
!/tools/
/tools/*
!/tools/*.py

# Disposable-VM course sources are teaching material, not generated VM images.
!/labs/
/labs/*
!/labs/vm/
/labs/vm/*
!/labs/vm/*.md
!/labs/vm/cloud-init.yaml.in
!/labs/vm/guest/
