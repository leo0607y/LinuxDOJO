# コピーして .env.deploy を作る。 .env.deploy は Git に入らない。実値をこのファイルに書かないこと。
CLOUDFLARE_PAGES_PROJECT=your-pages-project-name
CLOUDFLARE_PAGES_BRANCH=main
# 'npx wrangler login' でブラウザ認証する場合は以下は不要。
# トークンは Pages の Edit 権限のみ (Account > Cloudflare Pages > Edit) で作成する。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 広告枠レイアウトのローカル確認専用 (広告通信は発生しない)。本番では設定しない。
# NEXT_PUBLIC_ADSENSE_PREVIEW=true
# Buy Me a CoffeeのページURL (例: https://www.buymeacoffee.com/yourname)
# NEXT_PUBLIC_BMC_URL=
